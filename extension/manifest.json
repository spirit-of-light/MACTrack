{
  "manifest_version": 3,
  "name": "MacTracker",
  "version": "0.1.1",
  "browser_specific_settings": {
    "gecko": { "id": "mactracker@local", "data_collection_permissions": { "required": ["none"] } }
  },
  "background": { "scripts": ["parse.js", "background.js"] },
  "action": { "default_title": "Sync MacTracker" },
  "options_ui": { "page": "options.html" },
  "permissions": ["alarms", "storage", "notifications", "tabs"],
  "host_permissions": [
    "https://avenue.cllmcmaster.ca/*",
    "https://mcmaster.simplesyllabusca.com/*",
    "https://app.crowdmark.com/*",
    "https://www.childsmath.ca/*",
    "http://127.0.0.1:8000/*"
  ]
}
